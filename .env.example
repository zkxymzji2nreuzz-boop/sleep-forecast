# SleepForecast 環境変数サンプル
# 実値は .env.local に記述し、git には含めないこと

# サイトの公開 URL (OGP / canonical / sitemap で使用)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 の測定 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google AdSense のクライアント ID (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Supabase (REQ-P2-01) — 設定しない場合は localStorage のみモードで動作
# Supabase ダッシュボード > Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
